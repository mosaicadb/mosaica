+    print(f"{name:8s} {B//8:6d}   {str(clip):5s} {100*r[0]/max(r[1],1):9.3f}   {r[2]/r[6]/nI:11.5f}   {r[3]/r[6]/nT:11.5f}   {100*r[4]/r[6]/nI:11.3f}  {100*r[5]/r[6]/nT:7.3f}  {int(r[7])}")
