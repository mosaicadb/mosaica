+/// Inverse of a row-major n x n matrix by Gauss-Jordan elimination with partial pivoting.
+fn gauss_jordan_inverse(a: &[f64], n: usize) -> Vec<f64> {
+    let w = 2 * n;
+    let mut m = vec![0f64; n * w];
+    for i in 0..n {
+        m[i * w..i * w + n].copy_from_slice(&a[i * n..(i + 1) * n]);
